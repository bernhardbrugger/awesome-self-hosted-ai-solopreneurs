# Copy this file to .env and fill in your own values:
#   cp .env.example .env

# Image tags — pin these to a specific version once you're past the
# evaluation stage, instead of tracking "latest"/"main" indefinitely.
OLLAMA_DOCKER_TAG=latest
WEBUI_DOCKER_TAG=main

# Port Open WebUI is published on. Put this behind a reverse proxy with
# TLS (e.g. via Coolify, or Traefik/Caddy directly) rather than exposing it
# raw on a public IP.
OPEN_WEBUI_PORT=3000

# Required. Generate a real random secret, e.g.:
#   openssl rand -hex 32
WEBUI_SECRET_KEY=
